	<div class="contribution-grid" data-contribution-grid role="list" aria-label="Daily contributions"></div>
	<div
		class="contribution-grid skeleton-grid"
		data-loading-skeleton
		aria-hidden="true"
		hidden
	></div>
</section>

<style>
	.contributions {
