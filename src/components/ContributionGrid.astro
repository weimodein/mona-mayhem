		box-shadow: 0 0 6px rgb(95 237 131 / 42%);
	}

	.contribution-grid :global(.contribution-day[data-level='3']) {
		background: #23d681;
		box-shadow: 0 0 9px rgb(95 237 131 / 70%);
	}

	.contribution-grid :global(.contribution-day[data-level='4']) {
		background: #b7ff5e;
		box-shadow: 0 0 5px #b7ff5e, 0 0 12px rgb(95 237 131 / 85%);
	}

